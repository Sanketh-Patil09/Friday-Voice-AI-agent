# Environment Configuration for Friday AI Agent
# Copy this file to .env and fill in your API keys

# Groq LLM API Key
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Deepgram Speech-to-Text API Key
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs Text-to-Speech API Key
# Get yours at: https://elevenlabs.io/app/voice-lab
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Database URL (defaults to SQLite)
# DATABASE_URL=sqlite:///./database.db

# Optional: Server host and port
# SERVER_HOST=0.0.0.0
# SERVER_PORT=7860
